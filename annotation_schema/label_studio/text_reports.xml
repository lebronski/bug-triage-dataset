<View>
  <Header value="Баг-репорт $report_id ($source_project, $tracker)"/>
  <Text name="text" value="$text"/>
  <Header value="Уровень 1 — классы тикета" size="5"/>
  <Choices name="ticket_type" toName="text" choice="single" showInline="true" required="true">
    <Choice value="bug" hint="дефект: программа ведёт себя не так, как ожидается"/>
    <Choice value="feature_request" hint="просьба о новой функции или улучшении"/>
    <Choice value="question" hint="вопрос по использованию, не дефект"/>
    <Choice value="not_a_bug" hint="поведение корректно, дубликат, не воспроизводится или ошибка пользователя"/>
  </Choices>
  <Choices name="category" toName="text" choice="single" showInline="true" required="true">
    <Choice value="crash" hint="Падения и необработанные исключения"/>
    <Choice value="ui_layout" hint="Вёрстка и отображение интерфейса"/>
    <Choice value="authentication" hint="Аутентификация и авторизация"/>
    <Choice value="payment" hint="Ошибки оплаты и биллинга"/>
    <Choice value="database" hint="Ошибки базы данных и транзакций"/>
    <Choice value="network" hint="Сеть и соединения"/>
    <Choice value="performance" hint="Производительность и зависания"/>
    <Choice value="memory" hint="Утечки памяти и OutOfMemory"/>
    <Choice value="localization" hint="Локализация и кодировки"/>
    <Choice value="security" hint="Уязвимости и TLS/сертификаты"/>
    <Choice value="other" hint="не подходит ни под одну категорию"/>
  </Choices>
  <Choices name="component" toName="text" choice="single" showInline="true" required="true">
    <Choice value="Backend" hint="серверная логика, сервисы, воркеры, API"/>
    <Choice value="Frontend" hint="клиентский интерфейс: веб, десктоп, мобильный"/>
    <Choice value="Auth-service" hint="вход, токены, роли, права доступа"/>
    <Choice value="Billing" hint="платежи, счета, подписки, платёжные данные"/>
    <Choice value="Database" hint="хранение данных, SQL, драйверы БД, миграции, транзакции"/>
  </Choices>
  <View visibleWhen="choice-selected" whenTagName="ticket_type" whenChoiceValue="bug">
  <Choices name="severity" toName="text" choice="single" showInline="true" required="true">
    <Choice value="Blocker" hint="ключевой сценарий (вход, оплата, сохранение данных) недоступен всем или большинству без обходного пути; потеря или порча данных; потеря денег; эксплуатируемая уязвимость"/>
    <Choice value="Critical" hint="падение сервиса или функции, ошибка 5xx, ключевая функция не работает у части пользователей, обходной путь сложен"/>
    <Choice value="Major" hint="функция работает неверно, но есть обходной путь; заметная деградация производительности; элемент интерфейса непригоден на части платформ"/>
    <Choice value="Minor" hint="косметический дефект, опечатка, неточный перевод, вёрстка без блокировки действий, редкий пограничный случай"/>
  </Choices>
  </View>
  <Choices name="confidence" toName="text" choice="single" showInline="true" required="true">
    <Choice value="high" hint="разметчик уверен"/>
    <Choice value="low" hint="есть сомнения — тикет уходит на проверку второму разметчику"/>
  </Choices>
  <Header value="Структура документа: разделы и элементы" size="5"/>
  <Labels name="section" toName="text">
    <Label value="TITLE" background="#e6194b" hint="заголовок тикета (summary)"/>
    <Label value="DESCRIPTION" background="#3cb44b" hint="свободное описание проблемы"/>
    <Label value="STEPS" background="#4363d8" hint="шаги воспроизведения и предусловия"/>
    <Label value="EXPECTED" background="#f58231" hint="ожидаемый результат"/>
    <Label value="ACTUAL" background="#911eb4" hint="фактический результат, текст ошибки"/>
    <Label value="ENVIRONMENT" background="#46a0b0" hint="версии, платформы, устройства, User-Agent"/>
    <Label value="STACK_TRACE" background="#f032e6" hint="трассировка стека, дамп исключения"/>
    <Label value="CODE" background="#9a6324" hint="фрагмент кода, конфигурации или лога"/>
    <Label value="NOTES" background="#808000" hint="прочее: предложения по исправлению, ссылки, комментарии"/>
  </Labels>
  <Labels name="item" toName="text">
    <Label value="STEP" background="#e6194b" hint="один шаг воспроизведения (обычно строка списка)"/>
    <Label value="FRAME" background="#3cb44b" hint="один кадр трассировки стека (строка «at ...» или «File ..., line ...»)"/>
  </Labels>
  <Header value="Сущности, атрибуты, связи" size="5"/>
  <Labels name="entity" toName="text">
    <Label value="EXCEPTION" background="#e6194b" hint="тип исключения или ошибки: NullPointerException, sqlite3.OperationalError, TypeError"/>
    <Label value="ERROR_MESSAGE" background="#3cb44b" hint="текст сообщения об ошибке, показанный программой"/>
    <Label value="CODE_LOCATION" background="#4363d8" hint="место в коде: класс, метод, файл, модуль, кадр стека, переменная"/>
    <Label value="ERROR_CODE" background="#f58231" hint="код ошибки: HTTP-статус, сетевая ошибка, код выхода, SQLSTATE, CVE"/>
    <Label value="ENV" background="#911eb4" hint="окружение: ОС, браузер, устройство, среда выполнения, версия приложения, библиотека, СУБД"/>
    <Label value="UI_ELEMENT" background="#46a0b0" hint="элемент интерфейса, с которым связан дефект"/>
    <Label value="METRIC" background="#f032e6" hint="числовое значение с единицей: время, память, нагрузка, количество"/>
    <Label value="PII" background="#9a6324" hint="персональные и чувствительные данные — подлежат маскированию перед публикацией"/>
  </Labels>
  <View visibleWhen="region-selected" whenTagName="entity" whenLabelValue="CODE_LOCATION">
    <Header value="CODE_LOCATION: code_location_kind" size="6"/>
  <Choices name="code_location_kind" toName="text" choice="single" showInline="true" perRegion="true">
    <Choice value="class" hint="class"/>
    <Choice value="method" hint="method"/>
    <Choice value="file" hint="file"/>
    <Choice value="module" hint="module"/>
    <Choice value="frame" hint="frame"/>
    <Choice value="variable" hint="variable"/>
  </Choices>
  </View>
  <View visibleWhen="region-selected" whenTagName="entity" whenLabelValue="ERROR_CODE">
    <Header value="ERROR_CODE: error_code_kind" size="6"/>
  <Choices name="error_code_kind" toName="text" choice="single" showInline="true" perRegion="true">
    <Choice value="http_status" hint="http_status"/>
    <Choice value="net_error" hint="net_error"/>
    <Choice value="exit_code" hint="exit_code"/>
    <Choice value="sql_state" hint="sql_state"/>
    <Choice value="app_code" hint="app_code"/>
    <Choice value="cve" hint="cve"/>
  </Choices>
  </View>
  <View visibleWhen="region-selected" whenTagName="entity" whenLabelValue="ENV">
    <Header value="ENV: env_kind" size="6"/>
  <Choices name="env_kind" toName="text" choice="single" showInline="true" perRegion="true">
    <Choice value="os" hint="os"/>
    <Choice value="browser" hint="browser"/>
    <Choice value="device" hint="device"/>
    <Choice value="runtime" hint="runtime"/>
    <Choice value="app_version" hint="app_version"/>
    <Choice value="library" hint="library"/>
    <Choice value="database" hint="database"/>
  </Choices>
  </View>
  <View visibleWhen="region-selected" whenTagName="entity" whenLabelValue="ENV">
    <Header value="ENV: env_affected" size="6"/>
  <Choices name="env_affected" toName="text" choice="single" showInline="true" perRegion="true">
    <Choice value="yes" hint="yes"/>
    <Choice value="no" hint="no"/>
    <Choice value="unknown" hint="unknown"/>
  </Choices>
  </View>
  <View visibleWhen="region-selected" whenTagName="entity" whenLabelValue="UI_ELEMENT">
    <Header value="UI_ELEMENT: ui_element_kind" size="6"/>
  <Choices name="ui_element_kind" toName="text" choice="single" showInline="true" perRegion="true">
    <Choice value="button" hint="button"/>
    <Choice value="field" hint="field"/>
    <Choice value="dialog" hint="dialog"/>
    <Choice value="menu" hint="menu"/>
    <Choice value="page" hint="page"/>
    <Choice value="link" hint="link"/>
    <Choice value="list" hint="list"/>
    <Choice value="other" hint="other"/>
  </Choices>
  </View>
  <View visibleWhen="region-selected" whenTagName="entity" whenLabelValue="METRIC">
    <Header value="METRIC: metric_kind" size="6"/>
  <Choices name="metric_kind" toName="text" choice="single" showInline="true" perRegion="true">
    <Choice value="time" hint="time"/>
    <Choice value="memory" hint="memory"/>
    <Choice value="cpu" hint="cpu"/>
    <Choice value="count" hint="count"/>
    <Choice value="size" hint="size"/>
  </Choices>
  </View>
  <View visibleWhen="region-selected" whenTagName="entity" whenLabelValue="PII">
    <Header value="PII: pii_kind" size="6"/>
  <Choices name="pii_kind" toName="text" choice="single" showInline="true" perRegion="true">
    <Choice value="person_name" hint="person_name"/>
    <Choice value="email" hint="email"/>
    <Choice value="ip" hint="ip"/>
    <Choice value="host" hint="host"/>
    <Choice value="username" hint="username"/>
    <Choice value="card" hint="card"/>
    <Choice value="token" hint="token"/>
    <Choice value="phone" hint="phone"/>
  </Choices>
  </View>
  <View visibleWhen="region-selected" whenTagName="entity">
    <TextArea name="normalized" toName="text" perRegion="true" editable="true" maxSubmissions="1" placeholder="normalized: каноническая запись (NullPointerException, macOS 12, 500)"/>
  </View>
  <Relations>
    <Relation value="HAS_MESSAGE"/>
    <Relation value="THROWN_AT"/>
    <Relation value="OBSERVED_IN"/>
  </Relations>
</View>
